{
  "manifest_version": 3,
  "name": "CONVOSAGE AI",
  "short_name": "CONVOSAGE",
  "version": "2.0.0",
  "description": "Attendee-controlled meeting intelligence: grounded live questions, knowledge continuity and searchable sessions.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open CONVOSAGE AI", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "tabCapture", "offscreen", "desktopCapture", "activeTab", "notifications"],
  "host_permissions": ["https://*.supabase.co/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
