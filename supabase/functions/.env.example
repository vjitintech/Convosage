# ─── CONVOSAGE AI server secrets ──────────────────────────────────────────────
# Copy to supabase/functions/.env, fill in, then:  supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_DB_URL and keys are injected automatically in hosted Edge Functions.

# AI model gateway (Anthropic Claude by default; or any OpenAI-compatible endpoint incl. Ollama/vLLM)
MODEL_PROVIDER=anthropic
MODEL_BASE_URL=https://api.anthropic.com
MODEL_API_KEY=sk-ant-REPLACE_ME
MODEL_NAME=claude-sonnet-5-5
MODEL_NAME_LARGE=claude-opus-5-5
VISION_MODEL=claude-sonnet-5-5
AI_DAILY_CALL_LIMIT=2000

# Speech-to-text (OpenAI-compatible /audio/transcriptions: OpenAI Whisper or a self-hosted server)
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=sk-REPLACE_ME
ASR_MODEL=whisper-1

# Billing — Razorpay (Indian company account; international cards; INR settlement to your current account)
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME          # rzp_live_… after go-live
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_PLAN_ID=plan_REPLACE_ME             # USD 10.00 monthly plan created in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
PLAN_LABEL=CONVOSAGE Pro — US$10 / month
# Dummy-payment accounts (E.164 without +). These always use the in-extension test checkout, even in production.
TEST_PHONES=919999900001,15550100002
MOCK_BILLING_SECRET=REPLACE_WITH_32+_RANDOM_CHARS

# Security
MCP_SECRET_KEY=REPLACE_WITH_32+_RANDOM_CHARS   # encrypts MCP server tokens at rest
CRON_SECRET=REPLACE_WITH_32+_RANDOM_CHARS      # protects /v1/internal/run-jobs
# Leave empty while testing (any browser extension may call the API; sign-in is still required).
# After publishing, lock it down: ALLOWED_ORIGINS=chrome-extension://<chrome-id>,chrome-extension://<edge-id>
ALLOWED_ORIGINS=

# Limits
CAPTURE_TOKEN_TTL_SEC=600
RATE_LIMIT_PER_MINUTE=240
# 0 = delete erases immediately (default). Set e.g. 7 to keep an undo window.
DELETION_GRACE_DAYS=0
MCP_MAX_TOOL_CALLS=3
